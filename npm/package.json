  "license": "MIT",
  "author": "Erfan Abouei",
  "homepage": "https://github.com/Erfan-Abouei/Abouei_Checker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erfan-Abouei/Abouei_Checker.git"
  },
  "bugs": {
    "url": "https://github.com/Erfan-Abouei/Abouei_Checker/issues"
  },
  "keywords": [
    "health-check",
    "monitoring",
    "uptime",
    "cli",
    "tui",
    "webhook",
    "incident"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
